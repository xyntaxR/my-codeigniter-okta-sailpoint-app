# ============================================
# Environment Configuration File
# ============================================
# Copy this file to .env and update with your actual credentials
# NEVER commit .env to version control!

# ============================================
# APPLICATION SETTINGS
# ============================================
CI_ENV=development
BASE_URL=http://localhost/my-codeigniter-okta-app/

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=okta_app

# ============================================
# OKTA AUTHENTICATION SETTINGS
# ============================================
# Your Okta domain (e.g., dev-12345.okta.com)
OKTA_DOMAIN=integrator-4569280.okta.com

# Okta OAuth Client ID
OKTA_CLIENT_ID=0oaxisl7lmsKan8co697

# Okta OAuth Client Secret
OKTA_CLIENT_SECRET=_rGyxNtu6l597DQheE5lc4vQdSe4CCB4FoFsoLpIKePrgv44GbY8LHlGQ8ZKEhHQ

# Okta Authorization Server ID (usually 'default')
OKTA_AUTH_SERVER_ID=default

# Redirect URI after successful authentication
OKTA_REDIRECT_URI=http://localhost/my-codeigniter-okta-app/index.php/auth/callback

# Post logout redirect URI
OKTA_POST_LOGOUT_REDIRECT_URI=http://localhost/my-codeigniter-okta-app/

# ============================================
# SAILPOINT IDENTITY GOVERNANCE SETTINGS
# ============================================
# SailPoint Domain (e.g., your-tenant.api.identitynow.com)
SAILPOINT_DOMAIN=your-tenant.api.identitynow.com

# SailPoint API Client ID
SAILPOINT_CLIENT_ID=

# SailPoint API Client Secret
SAILPOINT_CLIENT_SECRET=

# SailPoint API Version (typically 'v3')
SAILPOINT_API_VERSION=v3

# SailPoint Personal Access Token (alternative to client credentials)
SAILPOINT_ACCESS_TOKEN=

# ============================================
# SESSION & SECURITY
# ============================================
# Session encryption key (generate a random 32-character string)
ENCRYPTION_KEY=

# Session cookie name
SESS_COOKIE_NAME=ci_session

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
EMAIL_PROTOCOL=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ============================================
# LOGGING & DEBUGGING
# ============================================
LOG_THRESHOLD=1
# 0 = Disable logging, 1 = Error, 2 = Debug, 3 = Info, 4 = All

# ============================================
# NOTES
# ============================================
# To generate a secure encryption key, run:
# php -r "echo bin2hex(random_bytes(16));"
#
# Make sure to:
# 1. Update all placeholder values with your actual credentials
# 2. Keep this file secure and never commit it to version control
# 3. Add .env to your .gitignore file
